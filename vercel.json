{
  "buildCommand": "vite build",
  "outputDirectory": "dist/public",
  "functions": {
    "api/index.ts": {
      "maxDuration": 60,
      "memory": 1024,
      "includeFiles": "{server/**,shared/**,drizzle/**,content/**}"
    },
    "api/oauth.ts": {
      "maxDuration": 60,
      "memory": 1024,
      "includeFiles": "{server/**,shared/**,drizzle/**,content/**}"
    },
    "api/google-login.ts": {
      "maxDuration": 30,
      "memory": 1024
    },
    "api/google-callback.ts": {
      "maxDuration": 60,
      "memory": 1024
    },
    "api/auth-session.ts": {
      "maxDuration": 30,
      "memory": 512
    }
  },
  "rewrites": [
    {
      "source": "/api/health",
      "destination": "/api/health.ts"
    },
    {
      "source": "/api/diag-env",
      "destination": "/api/diag-env.ts"
    },
    {
      "source": "/api/smoke",
      "destination": "/api/smoke.ts"
    },
    {
      "source": "/api/db-check",
      "destination": "/api/db-check.ts"
    },
    {
      "source": "/api/auth/google/login",
      "destination": "/api/google-login.ts"
    },
    {
      "source": "/api/auth/google/callback",
      "destination": "/api/google-callback.ts"
    },
    {
      "source": "/api/oauth/callback",
      "destination": "/api/oauth.ts"
    },
    {
      "source": "/api/auth/me",
      "destination": "/api/auth-session.ts"
    },
    {
      "source": "/api/auth/logout",
      "destination": "/api/auth-session.ts"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.ts"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
