# ===== Modo recomendado (com banco, analytics, SRS e progresso) =====
# Deixe VITE_STATIC_STUDY desativado para liberar todas as funcionalidades.
VITE_STATIC_STUDY=false

# Backend: por padrão usa banco e faz fallback para study-pack quando faltar dado.
# Defina true somente se quiser forçar modo local estático no backend.
STUDY_PACK_ONLY=false

# URL de conexão MySQL (produção/dev com banco)
# Exemplo: mysql://user:password@host:3306/constituicao
# DATABASE_URL=

# Opcional: OAuth (só faz sentido com backend e DATABASE_URL configurados).
# VITE_OAUTH_PORTAL_URL=
# VITE_APP_ID=

# OAuth Google direto (recomendado para desenvolvimento local)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
# Opcional (legado): o link "Entrar" usa /api/auth/google/login direto; não precisa no cliente.
# VITE_GOOGLE_CLIENT_ID=
